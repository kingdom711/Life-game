# Backend API Configuration
# 로컬 백엔드 사용 시: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCK=false
VITE_API_TIMEOUT=30000
VITE_DEV_MODE=true

# API Logging (운영환경에서는 false)
VITE_ENABLE_API_LOGGING=true

# Google Analytics 4 (선택 — 없으면 비워두세요)
VITE_GA_MEASUREMENT_ID=
VITE_GA_DEBUG_MODE=false

# YouTube Data API v3 (선택 — 본인 키 발급 후 입력)
YOUTUBE_API_KEY=
